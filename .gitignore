# 1. Dependencies & Package Caches
node_modules/
**/node_modules/
.pnp
.pnp.js
package-lock.json.bak

# 2. Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.jks
*.keystore
*api*.txt
*key*.txt
*.secret

