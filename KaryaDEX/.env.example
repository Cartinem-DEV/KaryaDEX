# ==============================================================================
# KaryaDEX — Open Source Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development server:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your .env file or real secrets to GitHub or version control.
# - ONLY use publishable / anon keys in client bundles.
# - NEVER include database passwords, service_role keys, or provider API keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Settings -> API -> Project URL & anon key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# ------------------------------------------------------------------------------
# 2. Google OAuth Authentication (Optional for Guest Mode)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Web Client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Cloudflare Workers AI Gateway (Optional for AI Cloud Routing)
# ------------------------------------------------------------------------------
# Deployed Cloudflare Worker URL for server-side AI proxying:
EXPO_PUBLIC_CLOUDFLARE_WORKER_URL=https://your-worker-subdomain.workers.dev

# Shared secret key between client and worker email endpoints
EXPO_PUBLIC_EMAIL_API_KEY=your-client-email-api-key

# ------------------------------------------------------------------------------
# 4. Error Tracking & Monitoring (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for crash reporting:
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456

# ------------------------------------------------------------------------------
# 5. Application Metadata
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_BUILD_NUMBER=1
