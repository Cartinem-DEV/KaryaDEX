{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["../"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}