# Supabase Edge Functions Environment Variables (Phase 12 AI Gateway)
# NEVER commit real secret values here. Use Supabase Dashboard or CLI secrets:
# npx supabase secrets set GEMINI_API_KEY=your_key MISTRAL_API_KEY=your_key

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Provider Secrets (NEVER exposed to mobile/web client bundle)
GEMINI_API_KEY=your_google_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
