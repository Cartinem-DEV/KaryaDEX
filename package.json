{
  "name": "karyadex-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix KaryaDEX install && npm --prefix workers/ai-gateway install",
    "start": "npm --prefix KaryaDEX run start",
    "start:lan": "npm --prefix KaryaDEX run start:lan",
    "web": "npm --prefix KaryaDEX run web",
    "tunnel": "npm --prefix KaryaDEX run tunnel",
    "android": "npm --prefix KaryaDEX run android",
    "ios": "npm --prefix KaryaDEX run ios",
